# OpenAN Knowledge Service 环境变量示例
# 复制为 .env 使用；.env 含真实凭据，已被 .gitignore 排除，永不提交。

# --- PostgreSQL（含 pgvector 扩展镜像） ---
POSTGRES_DB=openan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # 必填，建议 32 位随机值

# --- 应用数据库角色（非 superuser，空卷初始化时创建） ---
RKB_DB_USER=rag_app
RKB_DB_PASSWORD=              # 必填，建议 32 位随机值

# --- 模型凭据加密密钥（必填，建议 32+ 字节随机值） ---
RKB_SECRET_KEY=

# --- 本地账号 ---
AUTH_MODE=local
RKB_ADMIN_USERNAME=admin
RKB_ADMIN_PASSWORD=           # 留空则启动期随机生成到 0600 文件

# --- 对外端口 ---
KNOWLEDGE_BASE_PORT=8091
WEB_PORT=8080
WEB_BASE_URL=/

# --- 文件存储 ---
RKB_STORAGE_BACKEND=local

# --- 网络（可选：pip 镜像源，仅构建期） ---
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=

# --- 知识库模型配置 ---
EMBEDDING_MODEL=bge-base-zh-v1.5
EMBEDDING_DIMENSION=1024

# --- 可选的初始模型配置，也可登录后在「模型管理」填写 ---
# 网关地址使用容器可访问的地址。OpenAI 兼容服务通常以 /v1 结尾。
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
GENERATION_GATEWAY_URL=
GENERATION_API_KEY=
GENERATION_MODEL=
RERANK_URL=
RERANK_MODEL=
